# Server-side only. Copy to deploy/.env (gitignored) and fill in.
CURATOR_DB_PASSWORD=
# 32+ random chars; shared by api and web:  openssl rand -hex 32
CURATOR_API_SECRET=
# The exact public origin users open (scheme + host, no path). SIWE binds to it.
CURATOR_ORIGIN=https://187-77-128-156.sslip.io
CURATOR_SOURCE_URL=https://github.com/dvictor357/krystal-curator
# Optional: Telegram bot for alerts.
TELEGRAM_BOT_TOKEN=
# Keep false unless this server's egress is accepted by Krystal.
CURATOR_SERVER_FETCH=false
CURATOR_WEB_PORT=3200
# API published on loopback for the host nginx (deploy/nginx-api.conf) when the frontend
# runs elsewhere (Vercel). Leave as is; nginx + bearer secret guard it.
CURATOR_API_PORT=8100
# Wallets (comma separated) that can read usage metering in Settings.
CURATOR_ADMIN_ADDRESSES=
