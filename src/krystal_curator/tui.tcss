/* Bloomberg-style: black ground, amber chrome, white data. */
Screen {
    background: #000000;
    color: #d8d8d8;
}

#topbar {
    height: 1;
    background: #ff9a00;
    color: #000000;
    text-style: bold;
    padding: 0 1;
}

#body {
    height: 1fr;
}

#table {
    width: 1fr;
    height: 1fr;
    border: solid #a05e00;
    border-title-color: #ffb000;
    border-title-style: bold;
    background: #000000;
    scrollbar-color: #ff9a00;
    scrollbar-background: #1a1a1a;
}

DataTable > .datatable--header {
    background: #1a1000;
    color: #ffb000;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #3a2600;
    color: #ffffff;
}
DataTable > .datatable--hover {
    background: #1e1e1e;
}
DataTable > .datatable--fixed {
    background: #000000;
    color: #ffb000;
}

#detail {
    width: 76;
    height: 1fr;
    border: solid #a05e00;
    border-title-color: #ffb000;
    border-title-style: bold;
    padding: 0 1;
    background: #000000;
}
#hero {
    height: 8;
    margin-bottom: 1;
}
#logo0, #logo1 {
    width: 16;
    height: 8;
    margin-right: 1;
}
#hero_text {
    width: 1fr;
    height: 8;
}
#detail_body {
    height: 1fr;
    overflow-y: auto;
}

#status {
    height: 1;
    background: #101010;
    color: #ffb000;
    padding: 0 1;
}

#find, #size {
    height: 3;
    display: none;
    border: solid #ff9a00;
    background: #000000;
    color: #ffffff;
}
#find.visible, #size.visible {
    display: block;
}

Footer {
    background: #101010;
    color: #ffb000;
}
Footer > .footer--key {
    background: #ff9a00;
    color: #000000;
    text-style: bold;
}
Footer > .footer--description {
    color: #d8d8d8;
}
Footer > .footer--highlight {
    background: #2a1c00;
}
Footer > .footer--highlight-key {
    background: #ffd070;
    color: #000000;
}

LinksModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}
#links_box {
    width: 110;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    border: solid #ff9a00;
    border-title-color: #ffb000;
    border-title-style: bold;
    background: #000000;
    padding: 0 1;
}
#links_list {
    height: auto;
    max-height: 30;
    background: #000000;
    color: #d8d8d8;
    border: none;
}
#links_list > .option-list--option-highlighted {
    background: #3a2600;
    color: #ffffff;
}
#links_help {
    height: 1;
    color: #ffb000;
    padding-left: 1;
}

PositionsScreen {
    background: #000000;
}
#pos_topbar {
    height: 1;
    background: #ff9a00;
    color: #000000;
    text-style: bold;
    padding: 0 1;
}
#pos_table {
    height: 1fr;
    border: solid #a05e00;
    border-title-color: #ffb000;
    border-title-style: bold;
    background: #000000;
}
#pos_status {
    height: 1;
    background: #101010;
    color: #ffb000;
    padding: 0 1;
}
