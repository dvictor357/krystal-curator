CURATOR_DATABASE_URL=postgres://curator:change-me@127.0.0.1:5432/curator
CURATOR_API_SECRET=
# false ONLY for local HTTP development; production default is true.
CURATOR_COOKIE_SECURE=true
# Optional: Telegram bot token for per-user position alerts (users paste their chat ID in
# Settings). Unset = alert loop idle. CURATOR_ALERTS=false disables the loop entirely;
# CURATOR_ALERT_INTERVAL (seconds, default 300) sets the cadence.
TELEGRAM_BOT_TOKEN=
# Data path. Krystal's Cloudflare challenges datacenter egress, so by default the browser
# fetches Krystal and posts payloads to the API (per-user cache). Set true only where the
# server's own egress is accepted by Krystal (e.g. an allow-listed IP).
CURATOR_SERVER_FETCH=false
# Chain RPC for live pool prices (range/edge alerts). Defaults are public endpoints;
# CURATOR_RPC_<chainId> overrides one (empty disables it).
# CURATOR_RPC_4663=https://rpc.mainnet.chain.robinhood.com
